# ==============================================================================
# 无线 AP + 单设备单 IP + SK5(SOCKS5) 每设备独立出口
# 本文件由 .github/workflows/build-immortalwrt.yml 追加到 full.config 之后，
# 再执行 make defconfig，因此这里的 =y 会覆盖 full.config 里同名的 "is not set"。
# 注意: .config 里不能写行尾注释，本文件只使用以 # 开头的独立注释行。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、无线基础组件 (AP 模式)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y

# ------------------------------------------------------------------------------
# 二、无线网卡驱动
#     x86 机器本身不带无线，必须真的插了网卡才会出现 wlan/phy；
#     驱动装全了不会凭空长出一个 radio，但可以保证常见网卡即插即用。
# ------------------------------------------------------------------------------

# Intel AX101 / AX200 / AX201 / AX210 / AX411 / BE200
CONFIG_PACKAGE_kmod-iwlwifi=y
CONFIG_PACKAGE_iwlwifi-firmware-ax101=y
CONFIG_PACKAGE_iwlwifi-firmware-ax200=y
CONFIG_PACKAGE_iwlwifi-firmware-ax201=y
CONFIG_PACKAGE_iwlwifi-firmware-ax210=y
CONFIG_PACKAGE_iwlwifi-firmware-ax411=y
CONFIG_PACKAGE_iwlwifi-firmware-be200=y

# MediaTek MT76 系列 (PCIe / USB)
CONFIG_PACKAGE_kmod-mt76=y
CONFIG_PACKAGE_kmod-mt7601u=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x0e=y
CONFIG_PACKAGE_kmod-mt76x0u=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_kmod-mt76x2u=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_kmod-mt7921u=y
CONFIG_PACKAGE_kmod-mt7921-firmware=y
CONFIG_PACKAGE_kmod-mt7922-firmware=y
CONFIG_PACKAGE_kmod-mt7925e=y
CONFIG_PACKAGE_kmod-mt7925-firmware=y

# Qualcomm Atheros
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_kmod-ath9k-htc=y
CONFIG_PACKAGE_kmod-ath10k=y
CONFIG_PACKAGE_ath10k-board-qca988x=y
CONFIG_PACKAGE_ath10k-firmware-qca988x=y
CONFIG_PACKAGE_ath10k-board-qca9887=y
CONFIG_PACKAGE_ath10k-firmware-qca9887=y

# Realtek
CONFIG_PACKAGE_kmod-rtl8xxxu=y
CONFIG_PACKAGE_kmod-rtl8192cu=y
CONFIG_PACKAGE_kmod-rtw88-8821ce=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
CONFIG_PACKAGE_kmod-rtw88-8822be=y
CONFIG_PACKAGE_kmod-rtw88-8822ce=y
CONFIG_PACKAGE_kmod-rtw89-8851be=y
CONFIG_PACKAGE_kmod-rtw89-8852ae=y
CONFIG_PACKAGE_kmod-rtw89-8852be=y
CONFIG_PACKAGE_kmod-rtw89-8852ce=y
CONFIG_PACKAGE_kmod-rtw89-8922ae=y

# ------------------------------------------------------------------------------
# 三、SK5 出口所需内核能力
#     TPROXY + fwmark 策略路由 + 透明代理转发，镜像里 mihomo 由 diy-part2.sh 集成
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables-json=y
